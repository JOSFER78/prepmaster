rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // SuperAdmin privileges for josferestudio@gmail.com
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'josferestudio@gmail.com' ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email.lower() == 'josferestudio@gmail.com')
      );
    }

    // Helper function to check ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // SuperAdmin has full read/write access to all collections
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Menu plans
    match /menu_plans/{planId} {
      allow read, write: if isAuthenticated() || resource == null || resource.data.userId == request.auth.uid;
    }

    // Pantry items
    match /pantry_items/{itemId} {
      allow read, write: if isAuthenticated() || resource == null || resource.data.userId == request.auth.uid;
    }

    // Shopping items
    match /shopping_items/{itemId} {
      allow read, write: if isAuthenticated() || resource == null || resource.data.userId == request.auth.uid;
    }

    // System config (Superadmin management)
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
  }
}
